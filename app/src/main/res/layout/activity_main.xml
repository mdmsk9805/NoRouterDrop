<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textStyle="bold"
            android:textSize="16sp" />
        <TextView android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="&#8942;"
            android:textSize="26sp"
            android:contentDescription="More"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <TextView android:id="@+id/statusText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/status_off" android:textSize="15sp" />

    <TextView android:id="@+id/deviceText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Connected devices (long-press to remove)"
        android:textStyle="bold" />

    <ListView android:id="@+id/trustedList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button android:id="@+id/sendButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Send a file" />

    <Button android:id="@+id/pairButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1. Start pairing (tap on ONE phone only)" />

    <Button android:id="@+id/waitButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="2. Wait for the other phone (tap on the OTHER phone)" />

</LinearLayout>
